# === CAMUNDA ===
CAMUNDA_BASE_URL=http://localhost:8080/engine-rest
WORKER_ID=bot1-send-campaign-worker

# === EMAIL (Nodemailer / SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Công ty ABC <your_email@gmail.com>"

# === FACEBOOK PAGE ===
# Lấy tại: https://developers.facebook.com → Graph API Explorer
# Page Access Token cần quyền: pages_manage_posts, pages_read_engagement
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
# Ngôn ngữ post Facebook (vi_VN hoặc en_US)
FB_LOCALE=vi_VN

# === TELEGRAM ===
# Tạo bot tại @BotFather → lấy token
# Thêm bot vào Channel với quyền Admin (có thể đăng bài)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Channel ID: dạng @channel_username hoặc -100xxxxxxxxxx (numeric ID)
TELEGRAM_CHANNEL_ID=@your_channel_username

# === GOOGLE SHEETS ===
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json
CAMPAIGN_SHEET_ID=your_google_sheet_id_here
CAMPAIGN_SHEET_NAME=Bot1_Campaigns

# === GENERAL ===
LOG_LEVEL=info
NODE_ENV=development
