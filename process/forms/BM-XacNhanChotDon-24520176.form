      "id": "Field_0unitprice1",
      "layout": {
        "row": "Row_0unitprice1"
      }
    },
    {
      "label": "Hình thức nhận hàng",
      "values": [
        {
          "label": "Giao hàng",
          "value": "delivery"
        },
        {
          "label": "Nhận tại cửa hàng",
          "value": "store"
        },
        {
          "label": "Nhận tại đại lý",
          "value": "agent"
