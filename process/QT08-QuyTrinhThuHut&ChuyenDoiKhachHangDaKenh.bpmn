        <bpmn:flowNodeRef>Gateway_DuHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ManualTask_ChuanBiHang</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Bắt đầu">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_ChuanBiChienDich" name="Chuẩn bị chiến dịch" camunda:formRef="BM-ChuanBiChienDich-24520176" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_GuiChienDich" name="Gửi chiến dịch đa kênh" camunda:asyncBefore="true" camunda:type="external" camunda:topic="send-campaign">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="TimerEvent_ChoPhanHoiLead" name="Chờ 5s phản hồi lead">
      <bpmn:incoming>Flow_3a</bpmn:incoming>
      <bpmn:outgoing>Flow_3b</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UserTask_SangLocLead" name="Sàng lọc lead" camunda:formRef="BM-SangLocLead-24520176" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_3b</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_LeadDayDu" name="Lead đầy đủ?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5a</bpmn:outgoing>
      <bpmn:outgoing>Flow_5b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_BoSungLead" name="Bổ sung / xác minh lead" camunda:formRef="BM-XacMinhBoSungLead-24520176" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_5a</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_LuuVaChamDiemLead" name="Lưu lead và chấm điểm AI" camunda:asyncBefore="true" camunda:type="external" camunda:topic="save-score-lead">
      <bpmn:incoming>Flow_5b</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_TuVanSanPham" name="Tư vấn sản phẩm" camunda:formRef="BM-TuVanSanPham-24520176" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_KhachMua" name="Khách có mua?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9a</bpmn:outgoing>
      <bpmn:outgoing>Flow_9b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_KhongMua" name="Kết thúc - chưa chuyển đổi">
      <bpmn:incoming>Flow_9a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="ServiceTask_KiemTraTonKho" name="Kiểm tra tồn kho" scriptFormat="groovy">
      <bpmn:incoming>Flow_9b</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:script>
    execution.setVariable("stockAvailable", true)
  </bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_DuHang" name="Đủ hàng?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11a</bpmn:outgoing>
      <bpmn:outgoing>Flow_11b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
