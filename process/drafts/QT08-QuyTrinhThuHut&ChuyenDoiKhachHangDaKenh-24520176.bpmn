      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_HoanTat_di" bpmnElement="EndEvent_HoanTat">
        <dc:Bounds x="3260" y="292" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_KhongMua_di" bpmnElement="EndEvent_KhongMua">
        <dc:Bounds x="2272" y="292" width="36" height="36" />
