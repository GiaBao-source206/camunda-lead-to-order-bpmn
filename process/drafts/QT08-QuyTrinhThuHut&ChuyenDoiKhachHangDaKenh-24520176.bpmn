<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_ThuHutChuyenDoiDaKenh_Lab" targetNamespace="http://camunda.org/examples" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:process id="Process_ThuHutChuyenDoiDaKenh_Lab" name="Quy trình thu hút và chuyển đổi khách hàng đa kênh" isExecutable="true" camunda:versionTag="1.0.0" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Marketing" name="1. Marketing / Kinh doanh">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ChuanBiChienDich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_GuiChienDich</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="2. Sales / CSKH">
        <bpmn:flowNodeRef>UserTask_SangLocLead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LeadDayDu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_BoSungLead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_LuuVaChamDiemLead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_TuVanSanPham</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KhachMua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_XacNhanChotDon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_TaoHoaDonVaGuiEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_HoanTat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_KhongMua</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kho" name="3. Kho">
        <bpmn:flowNodeRef>ServiceTask_KiemTraTonKho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DuHang</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Bắt đầu">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_ChuanBiChienDich" name="Chuẩn bị chiến dịch" camunda:formRef="form-chuan-bi-chien-dich" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_GuiChienDich" name="Gửi chiến dịch đa kênh" camunda:asyncBefore="true" camunda:type="external" camunda:topic="send-campaign">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_SangLocLead" name="Sàng lọc lead" camunda:formRef="form-sang-loc-lead" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_LeadDayDu" name="Lead đầy đủ?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5a</bpmn:outgoing>
      <bpmn:outgoing>Flow_5b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_BoSungLead" name="Bổ sung / xác minh lead" camunda:formRef="form-bo-sung-xac-minh-lead" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_5a</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_LuuVaChamDiemLead" name="Lưu lead và chấm điểm AI" camunda:asyncBefore="true" camunda:type="external" camunda:topic="save-score-lead">
      <bpmn:incoming>Flow_5b</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_TuVanSanPham" name="Tư vấn sản phẩm" camunda:formRef="form-tu-van-san-pham" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_KhachMua" name="Khách có mua?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9a</bpmn:outgoing>
      <bpmn:outgoing>Flow_9b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_KhongMua" name="Kết thúc - chưa chuyển đổi">
      <bpmn:incoming>Flow_9a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask_KiemTraTonKho" name="Kiểm tra tồn kho" camunda:asyncBefore="true" camunda:type="external" camunda:topic="check-stock">
      <bpmn:incoming>Flow_9b</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DuHang" name="Đủ hàng?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11a</bpmn:outgoing>
      <bpmn:outgoing>Flow_11b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_XacNhanChotDon" name="Xác nhận chốt đơn" camunda:formRef="form-xac-nhan-chot-don" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_11b</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_TaoHoaDonVaGuiEmail" name="Tạo hóa đơn PDF và gửi email xác nhận" camunda:asyncBefore="true" camunda:type="external" camunda:topic="invoice-email">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_HoanTat" name="Hoàn tất">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="UserTask_ChuanBiChienDich" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="UserTask_ChuanBiChienDich" targetRef="ServiceTask_GuiChienDich" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ServiceTask_GuiChienDich" targetRef="UserTask_SangLocLead" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="UserTask_SangLocLead" targetRef="Gateway_LeadDayDu" />
    <bpmn:sequenceFlow id="Flow_5a" name="Chưa đủ" sourceRef="Gateway_LeadDayDu" targetRef="UserTask_BoSungLead">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${leadComplete == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5b" name="Đầy đủ" sourceRef="Gateway_LeadDayDu" targetRef="ServiceTask_LuuVaChamDiemLead">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${leadComplete == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="UserTask_BoSungLead" targetRef="UserTask_SangLocLead" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="ServiceTask_LuuVaChamDiemLead" targetRef="UserTask_TuVanSanPham" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="UserTask_TuVanSanPham" targetRef="Gateway_KhachMua" />
    <bpmn:sequenceFlow id="Flow_9a" name="Không mua" sourceRef="Gateway_KhachMua" targetRef="EndEvent_KhongMua">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerInterested == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9b" name="Có mua" sourceRef="Gateway_KhachMua" targetRef="ServiceTask_KiemTraTonKho">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerInterested == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="ServiceTask_KiemTraTonKho" targetRef="Gateway_DuHang" />
    <bpmn:sequenceFlow id="Flow_11a" name="Không đủ" sourceRef="Gateway_DuHang" targetRef="UserTask_TuVanSanPham">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stockAvailable == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11b" name="Đủ" sourceRef="Gateway_DuHang" targetRef="UserTask_XacNhanChotDon">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stockAvailable == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="UserTask_XacNhanChotDon" targetRef="ServiceTask_TaoHoaDonVaGuiEmail" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="ServiceTask_TaoHoaDonVaGuiEmail" targetRef="EndEvent_HoanTat" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ThuHutChuyenDoiDaKenh_Lab">
      <bpmndi:BPMNShape id="Lane_Kho_di" bpmnElement="Lane_Kho" isHorizontal="true">
        <dc:Bounds x="160" y="420" width="3400" height="140" />
