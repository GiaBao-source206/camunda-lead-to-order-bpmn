      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_KiemTraTonKho_di" bpmnElement="ServiceTask_KiemTraTonKho">
        <dc:Bounds x="2200" y="455" width="220" height="70" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
