      <bpmndi:BPMNShape id="UserTask_XacNhanChotDon_di" bpmnElement="UserTask_XacNhanChotDon">
        <dc:Bounds x="2640" y="275" width="240" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_TaoHoaDonVaGuiEmail_di" bpmnElement="ServiceTask_TaoHoaDonVaGuiEmail">
        <dc:Bounds x="2940" y="275" width="260" height="70" />
