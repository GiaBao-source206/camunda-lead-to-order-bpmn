      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_TuVanSanPham_di" bpmnElement="UserTask_TuVanSanPham">
        <dc:Bounds x="1760" y="275" width="240" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_KhachMua_di" bpmnElement="Gateway_KhachMua" isMarkerVisible="true">
        <dc:Bounds x="2060" y="285" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2046" y="260" width="77" height="14" />
